 {
  "id": "mi-vis-07",
  "name": "TAWS CAUTION",
  "ref": "FCOM R17 PRO-ABN-SURV P 1/8 to 2/8",
  "ident": "PRO-ABN-SURV-AA-00026795.0001001",
  "cond": "",
  "steps": [
   {
    "t": "s",
    "h": "<i>&quot;TERRAIN TERRAIN&quot; - &quot;TOO LOW TERRAIN&quot; - &quot;TERRAIN AHEAD&quot; - &quot;CAUTION TERRAIN&quot; - &quot;OBSTACLE AHEAD&quot; - &quot;CAUTION OBSTACLE&quot;</i>"
   },
   {
    "t": "s",
    "h": "<i>During night or IMC conditions:</i>"
   },
   {
    "t": "s",
    "h": "<i>Simultaneously:</i>"
   },
   {
    "t": "n",
    "n": "1",
    "h": "AP ... <b>OFF</b>"
   },
   {
    "t": "n",
    "n": "2",
    "h": "PITCH ... <b>PULL UP</b>"
   },
   {
    "t": "n",
    "n": "3",
    "h": "THRUST LEVERS ... <b>TOGA</b>"
   },
   {
    "t": "n",
    "n": "4",
    "h": "SPEED BRAKE LEVER ... <b>CHECK RETRACTED</b>"
   },
   {
    "t": "n",
    "n": "5",
    "h": "BANK ... <b>WINGS LEVEL or ADJUST</b>"
   },
   {
    "t": "b",
    "h": "DO NOT CHANGE CONFIGURATION (SLATS/FLAPS, GEAR) UNTIL CLEAR OF OBSTACLE."
   },
   {
    "t": "s",
    "h": "<i>During daylight and VMC conditions, with terrain and obstacles clearly in sight:</i>"
   },
   {
    "t": "n",
    "n": "6",
    "h": "FLIGHT PATH ... <b>ADJUST</b>"
   },
   {
    "t": "s",
    "h": "<i>&quot;SINK RATE&quot;</i>"
   },
   {
    "t": "s",
    "h": "<i>Above 1 000 ft AAL IMC or above 500 ft AAL VMC:</i>"
   },
   {
    "t": "n",
    "n": "7",
    "h": "FLIGHT PATH ... <b>ADJUST</b>"
   },
   {
    "t": "s",
    "h": "<i>Below 1 000 ft AAL IMC or below 500 ft AAL VMC:</i>"
   },
   {
    "t": "n",
    "n": "8",
    "h": "GO-AROUND ... <b>CONSIDER</b>"
   },
   {
    "t": "s",
    "h": "<i>&quot;DON’T SINK&quot;</i>"
   },
   {
    "t": "n",
    "n": "9",
    "h": "FLIGHT PATH ... <b>ADJUST</b>"
   },
   {
    "t": "s",
    "h": "<i>&quot;TOO LOW GEAR&quot; or &quot;TOO LOW FLAPS&quot;</i>"
   },
   {
    "t": "n",
    "n": "10",
    "h": "GO-AROUND ... <b>PERFORM</b>"
   },
   {
    "t": "s",
    "h": "<i>&quot;GLIDESLOPE&quot;</i>"
   },
   {
    "t": "s",
    "h": "<i>Above 1 000 ft AAL IMC or above 500 ft AAL VMC:</i>"
   },
   {
    "t": "n",
    "n": "11",
    "h": "FLIGHT PATH ... <b>ADJUST</b>"
   },
   {
    "t": "s",
    "h": "<i>When conditions require a deliberate approach below glideslope:</i>"
   },
   {
    "t": "n",
    "n": "12",
    "h": "G/S MODE ... <b>OFF</b>"
   },
   {
    "t": "s",
    "h": "<i>Below 1 000 ft AAL IMC or below 500 ft AAL VMC:</i>"
   },
   {
    "t": "n",
    "n": "13",
    "h": "GO-AROUND ... <b>CONSIDER</b>"
   }
  ],
  "fctm": "Memory items per FCOM R17 PRO-ABN-SURV P 1/8 to 2/8, ident PRO-ABN-SURV-AA-00026795.0001001. MEMORY ITEMS. Boxed lines recited cold, verbatim.",
  "fleet": "pax",
  "provenance": "manual"
 },
