 {
  "id": "mi-vis-05",
  "name": "UNRELIABLE SPEED INDICATION",
  "ref": "QRH R35 23.03A",
  "ident": "ABN-23-A-00017854.0001001",
  "cond": "",
  "steps": [
   {
    "t": "b",
    "h": "If the safe conduct of the flight is impacted"
   },
   {
    "t": "n",
    "n": "1",
    "h": "AP ... <b>OFF</b>"
   },
   {
    "t": "n",
    "n": "2",
    "h": "A/THR ... <b>OFF</b>"
   },
   {
    "t": "n",
    "n": "3",
    "h": "FD ... <b>OFF</b>"
   },
   {
    "t": "b",
    "h": "PITCH/THRUST"
   },
   {
    "t": "n",
    "n": "4",
    "h": "Below THRUST RED ALT ... <b>15° / TOGA</b>"
   },
   {
    "t": "n",
    "n": "5",
    "h": "Above THRUST RED ALT and Below FL 100 ... <b>10° / CLB</b>"
   },
   {
    "t": "n",
    "n": "6",
    "h": "Above THRUST RED ALT and Above FL 100 ... <b>5° / CLB</b>"
   },
   {
    "t": "n",
    "n": "7",
    "h": "FLAPS (if CONF 0(1)(2)(3)) ... <b>MAINTAIN CURRENT CONF</b>"
   },
   {
    "t": "n",
    "n": "8",
    "h": "FLAPS (if CONF FULL) ... <b>SELECT CONF 3 AND MAINTAIN</b>"
   },
   {
    "t": "n",
    "n": "9",
    "h": "SPEEDBRAKES ... <b>CHECK RETRACTED</b>"
   },
   {
    "t": "n",
    "n": "10",
    "h": "L/G ... <b>UP</b>"
   },
   {
    "t": "b",
    "h": "When at or above MSA or Circuit Altitude: Level off for troubleshooting"
   }
  ],
  "fctm": "Memory items per QRH R35 23.03A, ident ABN-23-A-00017854.0001001. MEMORY ITEMS. Boxed lines recited cold, verbatim.",
  "fleet": "pax",
  "provenance": "manual"
 },
 {
  "id": "mi-vis-06",
  "name": "LOSS OF BRAKING",
  "ref": "FCOM R17 PRO-ABN-BRAKES P 1/16",
  "ident": "PRO-ABN-BRAKES-00010803.0001001",
  "cond": "",
  "steps": [
   {
    "t": "s",
    "h": "<i>If no braking:</i>"
   },
   {
    "t": "n",
    "n": "1",
    "h": "REV ... <b>MAX</b>"
   },
   {
    "t": "n",
    "n": "2",
    "h": "BRAKE PEDALS ... <b>RELEASE</b>"
   },
   {
    "t": "n",
    "n": "3",
    "h": "A/SKID OFF ... <b>ORDER</b>"
   },
   {
    "t": "n",
    "n": "4",
    "h": "A/SKID &amp; N/W STRG ... <b>OFF</b>"
   },
   {
    "t": "n",
    "n": "5",
    "h": "BRAKE PEDALS ... <b>PRESS</b>"
   },
   {
    "t": "n",
    "n": "6",
    "h": "MAX BRK PR ... <b>1000 PSI</b>"
   },
   {
    "t": "s",
    "h": "<i>If still no braking:</i>"
   },
   {
    "t": "n",
    "n": "7",
    "h": "PARK BRAKE ... <b>USE</b>"
   }
  ],
  "fctm": "Memory items per FCOM R17 PRO-ABN-BRAKES P 1/16, ident PRO-ABN-BRAKES-00010803.0001001. MEMORY ITEMS. Boxed lines recited cold, verbatim.",
  "fleet": "pax",
  "provenance": "manual"
