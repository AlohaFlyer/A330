 {
  "id": "mi-vis-11",
  "name": "WINDSHEAR WARNING - REACTIVE WINDSHEAR",
  "ref": "FCOM R17 PRO-ABN-SURV P 6/8 to 7/8",
  "ident": "PRO-ABN-SURV-00012300.0001001",
  "cond": "",
  "steps": [
   {
    "t": "s",
    "h": "<i>At Takeoff:</i>"
   },
   {
    "t": "s",
    "h": "<i>Before V1:</i>"
   },
   {
    "t": "b",
    "h": "If there are significant variations in airspeed, and in airspeed trend below the indicated V1, reject the takeoff."
   },
   {
    "t": "s",
    "h": "<i>After V1:</i>"
   },
   {
    "t": "n",
    "n": "1",
    "h": "THR LEVERS ... <b>TOGA</b>"
   },
   {
    "t": "n",
    "n": "2",
    "h": "REACHING VR ... <b>ROTATE</b>"
   },
   {
    "t": "n",
    "n": "3",
    "h": "SRS ORDERS ... <b>FOLLOW</b>"
   },
   {
    "t": "s",
    "h": "<i>When airborne, during initial climb, or at landing:</i>"
   },
   {
    "t": "n",
    "n": "4",
    "h": "THR LEVERS AT TOGA ... <b>SET OR CONFIRM</b>"
   },
   {
    "t": "n",
    "n": "5",
    "h": "AP (if engaged) ... <b>KEEP ON</b>"
   },
   {
    "t": "n",
    "n": "6",
    "h": "SRS ORDERS ... <b>FOLLOW</b>"
   },
   {
    "t": "b",
    "h": "DO NOT CHANGE CONFIGURATION (SLATS/FLAPS, GEAR) UNTIL OUT OF WINDSHEAR."
   },
   {
    "t": "b",
    "h": "CAREFULLY MONITOR FLIGHT PATH AND SPEED."
   },
   {
    "t": "b",
    "h": "WHEN OUT OF WINDSHEAR, SMOOTHLY RECOVER NORMAL CLIMB."
   }
  ],
  "fctm": "Memory items per FCOM R17 PRO-ABN-SURV P 6/8 to 7/8, ident PRO-ABN-SURV-00012300.0001001. MEMORY ITEMS. Boxed lines recited cold, verbatim.",
