 {
  "id": "mi-vis-10",
  "name": "TCAS WARNING - RESOLUTION ADVISORY",
  "ref": "FCOM R17 PRO-ABN-SURV P 4/8 to 5/8",
  "ident": "PRO-ABN-SURV-00011464.0005001",
  "cond": "",
  "steps": [
   {
