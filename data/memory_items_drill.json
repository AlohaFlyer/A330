    "h": "AP (if engaged) ... <b>OFF</b>"
   },
   {
    "t": "n",
    "n": "2",
    "h": "BOTH FDs ... <b>OFF</b>"
   },
   {
    "t": "n",
    "n": "3",
    "h": "VERTICAL SPEED ... <b>ADJUST or MAINTAIN</b>"
   },
